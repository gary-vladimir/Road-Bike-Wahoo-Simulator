{
  "name": "bikesim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests *.ts *.json .devcontainer README.md docs",
    "format:check": "prettier --check src tests *.ts *.json .devcontainer README.md docs",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.214.0",
    "@react-three/fiber": "9.7.0",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
